{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    // NodeNext, not bundler: nothing bundles this — Node runs dist/ directly, so
    // relative imports need explicit .js extensions. `bundler` accepts
    // extensionless imports and emits them unchanged, which typechecks cleanly
    // and then throws ERR_MODULE_NOT_FOUND at runtime. NodeNext makes that a
    // compile error instead.
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "declaration": false,
    "sourceMap": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
