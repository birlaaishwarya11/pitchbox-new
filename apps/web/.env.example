# URL of the Express pipeline server (used by /pipeline and /test pages)
NEXT_PUBLIC_SERVER_BASE=http://localhost:3001

# Supabase — browser-safe values only. The anon/publishable key is designed to
# be public; NEVER put the service_role/secret key in a NEXT_PUBLIC_* var.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
