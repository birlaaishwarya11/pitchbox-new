# --- Key ownership ---------------------------------------------------------
# Pitchbox is bring-your-own-keys by default: every run supplies its own LLM and
# ElevenLabs key, and the two variables below are IGNORED. Set this to `true`
# only when self-hosting, to use the server's own keys as a fallback.
#
# Opt-in on purpose: leaving this unset costs you nothing, whereas leaving a key
# active on a public deployment quietly pays for everyone who finds the link.
PITCHBOX_ALLOW_SERVER_KEYS=

# Anthropic — fallback LLM. Only used when PITCHBOX_ALLOW_SERVER_KEYS=true.
ANTHROPIC_API_KEY=

# ElevenLabs — fallback voiceover key. Only used when PITCHBOX_ALLOW_SERVER_KEYS=true.
ELEVENLABS_API_KEY=
# Optional: override the default ElevenLabs voice
VOICE_ID=

# Optional: Daytona credentials for sandboxed recording/deployment
DAYTONA_API_KEY=
DAYTONA_API_URL=
DAYTONA_WORKSPACE_DIR=

# Optional: Vercel Blob token — mirrors generated audio if set
BLOB_READ_WRITE_TOKEN=

# Optional: server port (default: 3001)
PORT=3001

# Production: directory for generated media; point at a mounted persistent
# volume so videos survive restarts (e.g. /data). Defaults to repo ./recordings.
MEDIA_DIR=

# Production: comma-separated allowed web origin(s) for CORS (lock to your web
# domain, e.g. https://your-app.vercel.app). Empty = permissive (dev only).
CORS_ORIGIN=

# Supabase — required for sign-in + per-user usage limits. The SERVICE_ROLE /
# secret key bypasses row-level security: keep it server-side, NEVER expose it
# to the browser. Protected routes return 503 until both are set.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Max Daytona-backed runs (repo recording / deploy) per user per day (default 5).
# Voiceover and LLM calls are billed to the user's own keys and are NOT capped.
RUN_LIMIT_PER_DAY=5

# Max Daytona-backed runs per day across ALL users (default 50).
# THIS is what bounds your bill. Signup is open, so the per-user cap above only
# limits one account — someone willing to register ten times gets ten times the
# allowance. Set this to what you are genuinely willing to pay for in a day.
RUN_LIMIT_GLOBAL_PER_DAY=50

# --- Rate limits (all optional; defaults shown) ----------------------------
# Requests per IP/user per 15 min. Generous: the UI polls status every 1.5s, so
# one user watching a single run legitimately makes ~40 requests a minute.
RATE_LIMIT_GLOBAL_PER_15MIN=1000
# Pipeline starts per user per hour — the expensive path.
RATE_LIMIT_STARTS_PER_HOUR=20
# /api/validate-key per IP per hour. Unauthenticated and makes live outbound
# calls, so without a limit it is a free oracle for testing stolen API keys.
RATE_LIMIT_VALIDATE_PER_HOUR=20
# API keys minted per user per hour.
RATE_LIMIT_KEY_MINT_PER_HOUR=10
# Daytona-backed requests per user per hour (short-window burst guard; the
# daily caps above are the real spend limits).
RATE_LIMIT_SANDBOX_PER_HOUR=10

# Max concurrent in-memory sessions (default 200). Each holds a plan, research
# and every script version; this stops a loop exhausting a small box.
MAX_LIVE_SESSIONS=200
